# ---------------------------------------------------------------------------
# SiMu microservices - copy this file to .env next to docker-compose.yml
#   cp .env.example .env
# Every service has its own PostgreSQL instance (schema managed by Liquibase).
# ---------------------------------------------------------------------------

# ---------- Published ports ----------
GATEWAY_PORT=8081
AUTH_SERVICE_PORT=8082
USER_SERVICE_PORT=8083
MUSIC_SERVICE_PORT=8084
PLAYLIST_SERVICE_PORT=8085

AUTH_DB_EXPOSED_PORT=5434
USER_DB_EXPOSED_PORT=5435
MUSIC_DB_EXPOSED_PORT=5436
PLAYLIST_DB_EXPOSED_PORT=5437
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=9094
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- PostgreSQL: auth-service ----------
AUTH_DB_NAME=simu_auth
AUTH_DB_USER=simu
AUTH_DB_PASSWORD=change_me

# ---------- PostgreSQL: user-service ----------
USER_DB_NAME=simu_user
USER_DB_USER=simu
USER_DB_PASSWORD=change_me

# ---------- PostgreSQL: music-service ----------
MUSIC_DB_NAME=simu_music
MUSIC_DB_USER=simu
MUSIC_DB_PASSWORD=change_me

# ---------- PostgreSQL: playlist-service ----------
PLAYLIST_DB_NAME=simu_playlist
PLAYLIST_DB_USER=simu
PLAYLIST_DB_PASSWORD=change_me

# ---------- JWT (identical for gateway and every service, >= 32 chars) ----------
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ---------- Service-to-service key (>= 32 chars, same value in every service) ----------
INTERNAL_API_KEY=replace_with_a_long_random_internal_key

# ---------- Mail (MailHog locally, any SMTP relay in prod) ----------
MAIL_UI_PORT=8025
MAIL_SMTP_PORT=1025
APP_PUBLIC_URL=http://localhost:8090

# ---------- Object storage: MinIO locally, any S3-compatible endpoint in prod ----------
MINIO_ROOT_USER=simu
MINIO_ROOT_PASSWORD=simu-secret
S3_BUCKET=simu-music
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

# ---------- CORS (frontend dev server) ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ---------- Rate limits (gateway, per IP per minute) ----------
RATE_LIMIT_SIGNIN_PER_MINUTE=5
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_RECOVERY_PER_MINUTE=3
RATE_LIMIT_REFRESH_PER_MINUTE=30

# ---------- Google login (leave empty to disable the endpoint: it answers 503) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/v1/auth/oauth2/google/callback
OAUTH_FRONTEND_REDIRECT_URI=http://localhost:8090/oauth2/callback
OAUTH2_SECURE_COOKIE=false
# monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
JAEGER_UI_PORT=16686
OTLP_HTTP_PORT=4318
