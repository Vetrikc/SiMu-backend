# ---------------------------------------------------------------------------
# SiMu microservices - copy this file to .env next to docker-compose.yml
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---------- Published ports ----------
GATEWAY_PORT=8081
AUTH_SERVICE_PORT=8082
USER_SERVICE_PORT=8083
MUSIC_SERVICE_PORT=8084
PLAYLIST_SERVICE_PORT=8085

MYSQL_PORT=3306
AUTH_DB_EXPOSED_PORT=5434
USER_DB_EXPOSED_PORT=5435
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=9094
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- MySQL (music + playlist) ----------
MYSQL_ROOT_PASSWORD=change_me
MUSIC_DB_NAME=simu_music
PLAYLIST_DB_NAME=simu_playlist

# ---------- PostgreSQL (auth + user) ----------
AUTH_DB_NAME=simu_auth
AUTH_DB_USER=simu
AUTH_DB_PASSWORD=change_me
USER_DB_NAME=simu_user
USER_DB_USER=simu
USER_DB_PASSWORD=change_me

# ---------- JWT (identical for gateway and every service, >= 32 chars) ----------
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRATION_MS=3600000000

# ---------- Object storage: MinIO locally, any S3-compatible endpoint in prod ----------
MINIO_ROOT_USER=simu
MINIO_ROOT_PASSWORD=simu-secret
S3_BUCKET=simu-music
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

# ---------- CORS (frontend dev server) ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
